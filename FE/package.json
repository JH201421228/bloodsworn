{
  "name": "bloodsworn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "build:assets": "node tools/build-assets.mjs",
    "build:props": "node tools/build-props.mjs",
    "build:icons": "node tools/build-icons.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "build:android": "npm run build && npx cap sync android",
    "build:ios": "npm run build && npx cap sync ios",
    "release:aab": "npm run build:android && node tools/gradle.mjs bundleRelease",
    "release:apk": "npm run build:android && node tools/gradle.mjs assembleRelease",
    "build:audio": "node tools/encode-audio.mjs",
    "build:items": "node tools/gen-item-icons.mjs",
    "build:monsters": "node tools/build-monsters.mjs",
    "build:projectiles": "node tools/build-projectiles.mjs",
    "build:bosses": "node tools/build-bosses.mjs",
    "build:npcs": "node tools/build-npcs.mjs",
    "build:player-atk": "node tools/build-player-atk.mjs",
    "build:ui": "node tools/build-ui.mjs",
    "build:all-assets": "npm run build:assets && npm run build:player-atk && npm run build:props && npm run build:monsters && npm run build:npcs && npm run build:projectiles && npm run build:bosses && npm run build:items && npm run build:decals",
    "validate": "node tools/validate-data.mjs",
    "build:decals": "node tools/build-decals.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/toast": "^7.0.4",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "vite": "^7.3.1"
  }
}
