<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            ⚠ Android 16(API 36) "adaptive apps" 대응 — T705
            targetSdk 36 부터는 smallestWidth ≥ 600dp 인 기기(태블릿·폴더블 펼침)에서
            screenOrientation / resizeableActivity / aspect-ratio 제한을 시스템이 **무시**한다.
            즉 아래 landscape 잠금은 폰에서만 효력이 있다.
            이 property 는 API 37 까지만 유효한 한시적 opt-out 이다. 그때는 UI 를 세로에서도
            성립하게 만들거나 레터박스를 받아들여야 한다.
            https://developer.android.com/about/versions/16/behavior-changes-16#adaptive-layouts
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <!--
            ★ 「AdMob」 앱 ID — **없으면 앱이 시작하자마자 크래시한다.**
              「Google Mobile Ads」 SDK 는 초기화 시 이 메타데이터를 직접 읽고,
              값이 없으면 IllegalStateException 을 던지며 프로세스를 죽인다. 선택 사항이 아니다.

            현재 값은 「Google」 공식 **테스트용 샘플 앱 ID** 다. 계정 없이도 테스트 광고가 나온다.
              출처: https://developers.google.com/admob/android/quick-start
                    ("Sample AdMob app ID: ca-app-pub-3940256099942544~3347511713")

            ⚠ 실제 ID 로 바꿀 때 (docs/20-MONETIZATION.md §10.3):
              1) 아래 android:value 를 「AdMob」 콘솔의 **앱 ID** 로 바꾼다.
                 형식은 ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN — **물결표(~)** 다.
                 슬래시(/)가 들어간 값은 광고 **단위** ID 이고 여기 넣으면 크래시한다. 흔한 실수다.
              2) 광고 단위 ID 는 여기가 아니라 src/monetization/adConfig.js 의 REAL_UNITS 에 넣는다.
              3) 둘은 같은 계정의 같은 앱이어야 한다. 어긋나면 no_fill 로 조용히 실패한다.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:screenOrientation="landscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
        Permissions
        ★ INTERNET 은 게임이 서버를 부르기 때문이 아니다. Capacitor 의 WebView 가
          https://localhost 로 로컬 자산을 서빙하는 구조라 없으면 흰 화면이 뜬다.
          실제 외부 네트워크 전송은 없다(privacy/privacy-policy.html 근거).
        ★ 그 외 권한은 하나도 선언하지 않는다. 권한이 늘면 Play 데이터 보안 신고서와
          스토어 등록정보가 전부 따라 바뀐다.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 폰 전용은 아니지만 터치스크린이 없으면 조작이 불가능하다. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
</manifest>
