      다르면 부팅 순간 경계선이 보인다.
-->
<resources>
    <color name="colorPrimary">#0B0710</color>       <!-- VOID  — 정본 §2.1 배경 지정값 -->
    <color name="colorPrimaryDark">#0B0710</color>   <!-- VOID  — 상태바도 같은 값(경계선 방지) -->
    <color name="colorAccent">#8E1220</color>        <!-- BLOOD -->
    <color name="splashBackground">#0B0710</color>   <!-- VOID  — capacitor.config.json backgroundColor 와 동일해야 한다 -->
