<?xml version="1.0" encoding="utf-8"?>
<!--
    ⚠ 이 파일은 원래 없었다. styles.xml 의 AppTheme 이 @color/colorPrimary 를 참조하는데
      colors.xml 이 누락돼 있어 릴리스 빌드가 aapt 링크 단계에서 깨진다. (T705 에서 발견)
